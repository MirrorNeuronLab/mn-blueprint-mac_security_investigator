{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "mac_security_investigator_v1",
  "mode": "static_dag",
  "execution": {
    "strategy": "serial",
    "max_parallel_steps": 1
  },
  "dynamic": {
    "enabled": false
  },
  "steps": [
    {
      "id": "capture_mac_evidence",
      "kind": "source",
      "label": "Watch live Mac security logs",
      "goal": "Observe new events for the selected macOS security services and log signals.",
      "needs": [],
      "control": {
        "timeout_seconds": 300,
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "reconcile_evidence_history",
      "kind": "stage",
      "label": "Reconcile evidence history",
      "goal": "Commit immutable evidence to the Job history.",
      "needs": [
        "capture_mac_evidence"
      ],
      "control": {
        "timeout_seconds": 300,
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "investigate_temporal_behavior",
      "kind": "stage",
      "label": "Assess security signals",
      "goal": "Check live records for review signals and bind findings to retained evidence.",
      "needs": [
        "reconcile_evidence_history"
      ],
      "control": {
        "timeout_seconds": 300,
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "publish_security_review",
      "kind": "sink",
      "label": "Publish security report",
      "goal": "Publish a web report with the assessment, evidence and observation coverage.",
      "needs": [
        "investigate_temporal_behavior"
      ],
      "control": {
        "timeout_seconds": 300,
        "retry": {
          "max_attempts": 1
        }
      }
    }
  ]
}
